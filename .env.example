# Real Vietnamese market data is the application default. No broker is used.
STOCK_AGENT_DATA_PROVIDER=vnstock
VNSTOCK_SOURCE=VCI
# Real OHLCV fallback when the configured source rejects a cloud IP. Leave
# empty to disable fallback. The response still records the actual source.
VNSTOCK_PRICE_FALLBACK_SOURCES=KBS
VNSTOCK_TELEMETRY=off
# Optional override; keep it on drive D.
STOCK_AGENT_RUNTIME_DIR=
# EOD cache and immutable raw snapshots are stored under .runtime on drive D.
STOCK_AGENT_CACHE_ENABLED=true
STOCK_AGENT_CACHE_TTL_SECONDS=900
# Current instrument-listing catalogue cache. The immutable raw capture is
# saved under .runtime/snapshots with its provider URL and retrieval time.
STOCK_AGENT_UNIVERSE_CACHE_TTL_SECONDS=86400
STOCK_AGENT_PROVIDER_TIMEOUT_SECONDS=20
STOCK_AGENT_PROVIDER_MAX_ATTEMPTS=1
STOCK_AGENT_PROVIDER_RETRY_DELAY_SECONDS=0.4
# Pace every upstream attempt (including retry) to protect the provider.
STOCK_AGENT_PROVIDER_MIN_REQUEST_INTERVAL_SECONDS=3.2
STOCK_AGENT_PROVIDER_CIRCUIT_THRESHOLD=5
STOCK_AGENT_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
# Enrich live fundamental analysis only with labelled provider data. Failed
# optional calls remain unavailable; they are never replaced by mock values.
STOCK_AGENT_COMPANY_PROFILE_ENABLED=false
STOCK_AGENT_FINANCIAL_STATEMENTS_ENABLED=false

# Acquire up to the free-provider limit of quarterly statement periods. The
# source does not provide publication timestamps, so these rows are not used
# for point-in-time TTM calculations.
STOCK_AGENT_QUARTERLY_STATEMENTS_ENABLED=false

# Verified issuer events/corporate actions from the same VCI source.
STOCK_AGENT_ISSUER_EVENTS_ENABLED=false
# Fetch VNINDEX alongside an equity request to calculate aligned relative return.
# A benchmark failure leaves relative strength UNKNOWN and does not block analysis.
STOCK_AGENT_BENCHMARK_ENABLED=true
# Phase D technical liquidity diagnostic. This is a configurable data-quality
# filter, not a buy/sell recommendation threshold.
STOCK_AGENT_MIN_AVG_TRADED_VALUE_VND=1000000000
# Stores parser metadata only (never raw query text) in .runtime/telemetry/semantic.sqlite3.
STOCK_AGENT_SEMANTIC_TELEMETRY_ENABLED=true
# Research searches the local verified corpus first. When it has no match, live
# web discovery may return source URLs and retrieval timestamps (not claims).
STOCK_AGENT_WEB_SEARCH_ENABLED=true
# free uses GDELT news discovery, then Bing RSS compatibility; it needs no key.
# auto uses Brave only when BRAVE_SEARCH_API_KEY is set, otherwise free.
STOCK_AGENT_WEB_SEARCH_PROVIDER=free
BRAVE_SEARCH_API_KEY=
# Optional Brave freshness value: pd, pw, pm, py, or YYYY-MM-DDtoYYYY-MM-DD.
STOCK_AGENT_WEB_SEARCH_FRESHNESS=
# First probe the public HNX issuer/disclosure profile for a ticker. This helps
# avoid ambiguous symbols such as PNG being interpreted as ordinary web terms.
STOCK_AGENT_OFFICIAL_ISSUER_LOOKUP_ENABLED=true
# On an HNX miss, resolve the issuer name through the existing VCI/vnstock
# provider before complementary web discovery; this disambiguates short tickers.
STOCK_AGENT_COMPANY_NAME_LOOKUP_ENABLED=true
# Bounded Internet-research execution. External pages are session-only and are
# not automatically written to the verified local corpus.
STOCK_AGENT_RESEARCH_MAX_SEARCHES=3
STOCK_AGENT_RESEARCH_MAX_PAGES=3
STOCK_AGENT_RESEARCH_MAX_ITERATIONS=1
STOCK_AGENT_RESEARCH_TIMEOUT_SECONDS=20
STOCK_AGENT_RESEARCH_MAX_TOTAL_BYTES=3000000
# Local theory KB. Default database: .runtime/knowledge/knowledge.sqlite3 on D:.
# Seed documents are ingested automatically when the database is empty.
STOCK_AGENT_KNOWLEDGE_ENABLED=true
# Optional database override; keep it inside the D: workspace.
STOCK_AGENT_KNOWLEDGE_DATABASE=
STOCK_AGENT_LLM_PROVIDER=mock
# When `ollama` or `openai` is selected, append a schema-validated,
# evidence-bounded analyst commentary. It never overrides deterministic scores,
# LSTM output, or the BUY/HOLD/WATCH policy.
STOCK_AGENT_LLM_ANALYST_ENABLED=false
# Let specialist agents request bounded structured reviews from the configured
# LLM. Five roles can be enabled independently. This increases latency because
# one full analysis may make several local model calls.
STOCK_AGENT_LLM_SPECIALISTS_ENABLED=false
STOCK_AGENT_LLM_SPECIALIST_ROLES=data,technical,fundamental,risk,manager
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Finalized classroom LSTM V2. The Streamlit app enables it by default when
# TensorFlow and the checksummed artifacts are available. Set false to disable.
STOCK_AGENT_LSTM_ENABLED=true
# Optional override. Keep the artifact directory on drive D.
STOCK_AGENT_LSTM_ARTIFACT_DIR=
